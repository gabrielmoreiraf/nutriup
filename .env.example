# ============================================================
# NutriUp — variáveis de ambiente (brief §9)
# Copie para .env.local e preencha. NUNCA versione .env.local.
# ============================================================

# --- Banco (Neon / Postgres serverless) ---
DATABASE_URL=

# --- IA (Anthropic) — SERVIDOR APENAS, nunca vai pro cliente ---
ANTHROPIC_API_KEY=

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET=
NEXTAUTH_URL=              # URL pública em produção (ex: https://nutriup.vercel.app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cifra de dados sensíveis de saúde (medicação) em repouso ---
ENCRYPTION_KEY=           # string secreta forte; sem ela, dados ficam em texto puro (dev)

# --- E-mail (Resend) — verificação de cadastro ---
RESEND_API_KEY=
RESEND_FROM=              # ex: "NutriUp <no-reply@seudominio.com.br>"; vazio = onboarding@resend.dev (teste)

# --- Asaas (assinaturas — Pix e cartão) ---
ASAAS_API_KEY=
ASAAS_ENV=                # "production" ou "sandbox" (padrão: sandbox se vazio)
ASAAS_WEBHOOK_TOKEN=      # token estático conferido no header asaas-access-token

# --- Storage de imagens (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=            # URL pública do bucket (ex: https://pub-xxxx.r2.dev)

# --- Dev only ---
# ENABLE_DEV_SEED=1       # necessário para habilitar GET /api/dev/seed
